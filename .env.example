# Copy this file to .env and adjust as needed.

# SQLite (default). Prisma resolves relative "file:" paths relative to
# prisma/schema.prisma, so "file:../crm.db" puts the db at the project root.
DATABASE_URL="file:../crm.db"

# Optional. Base directory for the SQLite db file (via DATABASE_URL, set
# separately), session store, and generated secrets. Defaults to the project
# root — set this to a mounted volume path when running in Docker.
# DATA_DIR=/app/data

# Optional. Overrides for WebAuthn relying party / origin — required if the
# app isn't served from http://localhost:3000 (e.g. behind a reverse proxy).
# RP_ID=your-domain.com
# ORIGIN=https://your-domain.com
# PORT=3000
